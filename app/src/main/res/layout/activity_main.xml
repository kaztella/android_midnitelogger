<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="14dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:text="MidNite Logger" android:textSize="24sp" android:textStyle="bold"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/state" android:text="停止中" android:textSize="18sp"
            android:paddingTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/current" android:text="データ未取得" android:textSize="19sp"
            android:lineSpacingExtra="5dp" android:padding="12dp" android:background="#EAF4EE"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/classicIp" android:hint="Classic IP" android:inputType="text"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/loggerSsid" android:hint="NETGEAR SSID" android:inputType="text"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/uploadUrl" android:hint="アップロードURL（空欄可）" android:inputType="textUri"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/start" android:text="ロギング開始"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/stop" android:text="停止"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/upload" android:text="今すぐ30秒アップロード"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="24時間グラフの基準日時" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/chartDate" android:hint="2026-10-20"
            android:singleLine="true" android:inputType="date"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/chartTime" android:hint="00:00"
            android:singleLine="true" android:inputType="time"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <RadioGroup android:id="@+id/chartRangeMode" android:orientation="horizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/fromSelected" android:text="この日時から24時間"
                android:checked="true" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/toSelected" android:text="この日時まで24時間"
                android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" />
        </RadioGroup>
        <LinearLayout android:orientation="horizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/previousDay" android:text="前日"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
            <Button android:id="@+id/nextDay" android:text="翌日"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
            <Button android:id="@+id/refreshChart" android:text="表示"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView android:id="@+id/chartPeriod" android:text="表示期間"
            android:layout_width="match_parent" android:layout_height="wrap_content" />
        <jp.terada.midnitelogger.ChartView
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="6dp" />
        <TextView android:text="通信ログ（直近50件）" android:textStyle="bold"
            android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/refreshLog" android:text="ログ更新" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
            <Button android:id="@+id/clearLog" android:text="ログ消去" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView android:id="@+id/events" android:text="通信ログなし" android:textSize="14sp"
            android:textIsSelectable="true" android:typeface="monospace"
            android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
